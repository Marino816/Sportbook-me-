# Sportsbook Me DFS AI — Environment Configuration

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/apex_dfs
REDIS_URL=redis://localhost:6379/0

# API Keys
BALLDONTLIE_API_KEY=your_balldontlie_key_here
ODDS_API_KEY=your_the_odds_api_key_here
SPORTSGAMEODDS_API_KEY=your_sportsgameodds_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# PayKings (NMI) webhook HMAC key — server-side only, never NEXT_PUBLIC_.
# signature = HMAC_SHA256(signing_key, nonce + "." + raw_body)
PAYKINGS_WEBHOOK_SIGNING_KEY=
# PayKings Payment API security_key (Settings > Security Keys). Server-side only.
PAYKINGS_SECURITY_KEY=
# Public Collect.js tokenization key (merchant control panel: Settings > Security Keys,
# create a public key with Tokenization permission). Safe for the browser.
# This is NOT PAYKINGS_SECURITY_KEY.
NEXT_PUBLIC_PAYKINGS_TOKENIZATION_KEY=
FIREBASE_CREDENTIALS_JSON=path/to/firebase-adminsdk.json
JWT_SECRET_KEY=dev-secret-change-in-production

# OAuth — leave unset until Google Cloud / Apple Developer credentials exist.
# Do not put provider secrets in NEXT_PUBLIC_* variables.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://sportbook-me-production.up.railway.app/api/auth/oauth/google/callback
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_TEAM_ID=
# APPLE_OAUTH_KEY_ID=
# APPLE_OAUTH_PRIVATE_KEY=
# APPLE_OAUTH_REDIRECT_URI=https://sportbook-me-production.up.railway.app/api/auth/oauth/apple/callback
# PUBLIC_APP_URL=https://sbmedfsai.com

# Blue Collar DFS (server-side only — never commit a real key)
# Documented provider cap is 200 requests/day; SB ME uses a conservative
# internal ceiling of 150 (130 automated + 20 manual).
BCDFS_API_KEY=your_bcdfs_api_key_here
BCDFS_SCHEDULER_ENABLED=false
BCDFS_TICK_INTERVAL=600

# If set to true, gracefully falls back to mock data when API keys are missing
USE_DEMO_DATA_FALLBACK=true
