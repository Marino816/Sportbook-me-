{
  "name": "SPORTBOOK ME",
  "version": "1.1.0",
  "description": "SPORTBOOK ME Mobile — Powered by 🧠 SB ME Intelligent AI™",
  "main": "expo-router/entry",
  "scheme": "sportbookme",
  "expo": {
    "name": "SPORTBOOK ME",
    "slug": "sportbook-me-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": { "backgroundColor": "#000000", "resizeMode": "contain" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.sportbookme.app", "infoPlist": { "NSFaceIDUsageDescription": "Face ID is used to securely log in to SPORTBOOK ME" } },
    "android": { "adaptiveIcon": { "backgroundColor": "#000000" }, "package": "com.sportbookme.app" },
    "plugins": ["expo-router", "expo-secure-store", "expo-local-authentication"],
    "experiments": { "typedRoutes": true }
  }
}