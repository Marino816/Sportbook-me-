# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
FRONTEND_URL=https://bmedfsai.com
API_URL=https://api.bmedfsai.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...
BALLDONTLIE_API_KEY=...
ODDS_API_KEY=...
NODE_ENV=production
# Development-only Market Tools provider. Default sgo preserves production behavior.
# Set oddsapi_snapshot locally to serve saved Odds API snapshots without calling SGO.
# Ignored when NODE_ENV=production.
MARKET_TOOLS_PROVIDER=sgo
# Production-capable Odds API serving. Default OFF. Cutover is not applied by this file.
MARKET_TOOLS_ODDSAPI_ENABLED=false
MARKET_TOOLS_ODDSAPI_COLLECT=false
MARKET_TOOLS_CONTEXT_COLLECT=false
# Prepared cutover quota (not applied by this file). busiest_30_day + 25% contingency.
# MARKET_TOOLS_MONTHLY_CREDIT_LIMIT=468750
# MARKET_TOOLS_DAILY_CREDIT_LIMIT is derived from busy_day + 25% when unset.
# Cutover (later assignment only): MARKET_TOOLS_ODDSAPI_ENABLED=true and MARKET_TOOLS_ODDSAPI_COLLECT=true.
# Rollback: MARKET_TOOLS_ODDSAPI_ENABLED=false and MARKET_TOOLS_ODDSAPI_COLLECT=false.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
STITCH_API_KEY=your_stitch_api_key_here

# ── SB ME AI (customer chat assistant) ─────────────────────────
# REQUIRED before activation: a dedicated production AI credential.
# Do NOT reuse the Hermes development credential. Provision a new key.
AI_API_KEY=your-ai-provider-api-key
AI_PROVIDER=openrouter            # openrouter | openai | deepseek | anthropic
AI_MODEL=                         # e.g. openrouter/auto, gpt-4o-mini, claude-haiku-3-5-20241022
AI_BASE_URL=                      # optional override (self-hosted gateway)
AI_TIMEOUT=30
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# ── SB ME AI rate / cost limits (configurable) ─────────────────
AI_BURST_LIMIT=10                 # requests / 60s per user
FREE_AI_DAILY_LIMIT=20
PRO_AI_DAILY_LIMIT=200
ELITE_AI_DAILY_LIMIT=2000
AI_HARD_DAILY_LIMIT=2000          # hard ceiling regardless of tier
AI_DAILY_TOKEN_BUDGET=200000      # tokens/user/day cost ceiling
