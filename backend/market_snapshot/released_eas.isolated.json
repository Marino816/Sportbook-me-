{
  "cli": {
    "version": ">= 0.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SBME_DEV_CLIENT": "1",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8010/api"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8010/api"
      }
    },
    "development-apple": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportbook-me-apple-staging-apple-staging.up.railway.app/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {},
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportbook-me-production.up.railway.app/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6808706342"
      }
    }
  }
}
